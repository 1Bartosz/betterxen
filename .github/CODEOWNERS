/shims/runtime_veh/             @MacosPorters/maintainers
/shims/win32_bridge/            @MacosPorters/maintainers
/scripts/build-shims.sh         @MacosPorters/maintainers

# Track B: Memory (xmem) & Storage (XCRDAPI / DirectStorage)
/shims/xmem/                    @MacosPorters/maintainers
/shims/xcrdapi/                 @MacosPorters/maintainers

# Track C: Graphics (d3d12_xs, xg_xs, FidelityFX/BVH hooks)
/shims/d3d12_xs/                @MacosPorters/maintainers
/shims/xg_xs/                   @MacosPorters/maintainers
/shims/ffx_bvh_hooks/           @MacosPorters/maintainers

# Track D: Shader pipeline (DXBC/DXIL/ACCC/FSPX & RDNA2 transpiler)
